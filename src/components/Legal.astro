---
import Base from '../layouts/Base.astro';
import { LEGAL } from '../lib/legal';
interface Props { title: string; heading: string; description: string; path: string; }
const { title, heading, description, path } = Astro.props;
const others = LEGAL.filter(([u]) => u !== path);
---
<Base title={`${title} | Swarmnest`} description={description} path={path}>
<p class="crumbs"><a href="/">Home</a> / <a href="/legal/">Legal</a></p>
<h1>{heading}</h1>
<p class="small">Last updated Oct 15, 2026. This is a plain-English draft written by Swarmnest. It has not yet been reviewed by a lawyer and it is not legal advice. Questions: <a href="mailto:hello@swarmnest.ai">hello@swarmnest.ai</a>.</p>
<slot />
<h2>Related Policies</h2>
<p class="small">{others.map(([u, t], i) => <Fragment>{i > 0 ? ' · ' : ''}<a href={u}>{t}</a></Fragment>)}</p>
</Base>
