---
import { PLATFORMS, FORMATS, platformsUsed } from '../lib/skills';
const { cat = '', plat = '', fmt = '', label = 'Search Agent Skills' } = Astro.props;
---
<form id="ss" class="cs js-only" role="search" aria-label={label} hidden onsubmit="return false" data-cat={cat} data-plat={plat} data-fmt={fmt}>
<label for="ssq" class="cs-l">{label}</label>
<input id="ssq" type="search" placeholder="Search skills, rules and templates…" autocomplete="off" enterkeyhint="search">
<div class="ss-sel">
{!plat && <label>Platform <select id="ssp"><option value="">All Platforms</option>{platformsUsed.map(p=><option value={p.slug}>{p.name}</option>)}</select></label>}
{!fmt && <label>Format <select id="ssf"><option value="">All Formats</option>{FORMATS.filter(f=>f.key!=='legacy-gpt').map(f=><option value={f.slug}>{f.short}</option>)}</select></label>}
<label>Scripts <select id="sss"><option value="">Any</option><option value="i">Instructions Only</option><option value="s">Includes Scripts</option></select></label>
</div>
<p id="ss-status" class="small" role="status" aria-live="polite"></p>
</form>
<div id="ss-results" class="grid" hidden></div>
