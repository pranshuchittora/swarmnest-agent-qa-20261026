---
// One static slot per page. Not sticky, not animated, fixed min-height (no layout shift).
import { sponsorFor, houseFor } from '../lib/sponsors';
const { key = '' } = Astro.props;
const sp = sponsorFor(key);
const house = sp ? null : houseFor(key);
// Homepage (sitewide) only: a 3:1 banner replaces the logo and text.
const IMG = /^\/sponsors\/[a-z0-9_-]+\.(png|jpg|webp)$/;
const banner = sp && key === '' && sp.s.banner && IMG.test(sp.s.banner) ? sp.s.banner : null;
const short = (s: string) => (s.length > 160 ? s.slice(0, 157) + '…' : s);
// House card text: the pack's first sentence, cut at a word boundary.
const oneLine = (t: string) => { const f = t.split(/(?<=\.)\s/)[0]; if (f.length <= 110) return f; const c = f.slice(0, 108); return c.slice(0, c.lastIndexOf(' ')).replace(/[,:;]$/, '') + '…'; };
---
<aside class="slot" aria-label={sp ? 'Sponsored' : 'From Swarmnest'}>
{sp ? (
  <a class="slotc" href={sp.s.url} rel="sponsored noopener">
    <span class="slotl">Sponsored</span>
    {banner ? (
    <span class="slotban"><img src={banner} alt={`${sp.s.name}: ${sp.s.headline.slice(0, 40)}`} width="1200" height="400" loading="lazy" decoding="async" /></span>
    ) : (
    <span class="slotrow">{sp.s.logo && /^\/sponsors\/[a-z0-9_-]+\.(png|jpg|webp)$/.test(sp.s.logo) && <img class="slotimg" src={sp.s.logo} alt="" width="40" height="40" loading="lazy" decoding="async" />}<span>
    <strong>{sp.s.headline.slice(0, 40)}</strong>
    <span class="slott">{short(sp.s.text)}</span>
    <span class="slotn">{sp.s.name}</span></span></span>
    )}
  </a>
) : house && (
  <a class="slotc" href={`/marketplace/${house.slug}/`}>
    <span class="slotl house">From Swarmnest</span>
    <strong>{house.title}</strong>
    <span class="slott">{oneLine(house.summary)}</span>
    <span class="slotp"><b>{house.price}</b> · View Pack</span>
  </a>
)}
{house ? <a class="slota small" href="/advertise/">Your Brand Here · See Placements</a> : <a class="slota small" href="/advertise/">Advertise Here</a>}
</aside>
