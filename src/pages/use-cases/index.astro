---
import Base from '../../layouts/Base.astro';
import { USECASES, TEMPLATES } from '../../lib/content';
import { SITE } from '../../lib/data';
const ld=[{'@context':'https://schema.org','@type':'CollectionPage',name:'AI agent use cases',description:'Jobs people hand to AI agents, each linked to a ready-made agent template.',url:SITE+'/use-cases/'},
{'@context':'https://schema.org','@type':'ItemList',name:'Swarmnest AI agent use cases',itemListElement:USECASES.map((u,i)=>({'@type':'ListItem',position:i+1,url:`${SITE}/use-cases/${u.slug}/`,name:u.name}))},
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:SITE+'/'},{'@type':'ListItem',position:2,name:'Use cases',item:SITE+'/use-cases/'}]}];
const tn=(s:string)=>TEMPLATES.find(t=>t.slug===s)!.name;
---
<Base title="AI Agent Use Cases: Jobs to Hand to an Agent | Swarmnest" description="Eight practical jobs to give an AI agent, such as researching with sources, finding prospects and triaging email, each with a ready-made agent template and tools." path="/use-cases/" jsonld={ld}>
<h1>Use Cases</h1>
<p class="lead">A use case is a job you want done. Pick one, then open the <a href="/agent-templates/">agent template</a> that does it, with instructions, tools and a persona. Also available as <a href="/api/v1/use-cases.json">JSON</a>.</p>
<div class="grid">{USECASES.map(u=><a class="card" href={`/use-cases/${u.slug}/`}><h3>{u.name}</h3><p>{u.goal}</p><p class="small">Templates: {u.templates.map(tn).join(', ')}</p></a>)}</div>
</Base>
