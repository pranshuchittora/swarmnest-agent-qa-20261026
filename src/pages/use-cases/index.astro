---
import Base from '../../layouts/Base.astro';
import { PERSONAS } from '../../lib/content';
import { SITE } from '../../lib/data';
const ld=[{'@context':'https://schema.org','@type':'ItemList',name:'Swarmnest agent personas',itemListElement:PERSONAS.map((p,i)=>({'@type':'ListItem',position:i+1,url:`${SITE}/use-cases/${p.slug}/`,name:p.name}))},
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:SITE+'/'},{'@type':'ListItem',position:2,name:'Use cases',item:SITE+'/use-cases/'}]}];
---
<Base title="AI agent use cases and bot personas | Swarmnest" description="Eight ready-made AI agent personas with instructions, guardrails, example prompts and the tools they use." path="/use-cases/" jsonld={ld}>
<h1>Use cases &amp; personas</h1>
<p class="lead">Eight ready-made agent roles. Each has instructions you can paste into a system prompt, guardrails, example prompts and links to the tools it uses. Also available as <a href="/api/v1/personas.json">JSON</a>.</p>
<div class="grid">{PERSONAS.map(p=><a class="card" href={`/use-cases/${p.slug}/`}><h3>{p.name}</h3><p>{p.role}</p></a>)}</div>
<p class="small">A downloadable <a href="/marketplace/persona-bundle/">Persona Bundle</a> is coming to the marketplace.</p>
</Base>
