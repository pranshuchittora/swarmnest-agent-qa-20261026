---
import Base from '../../layouts/Base.astro';
import { USECASES, TEMPLATES } from '../../lib/content';
import { ALL, SITE } from '../../lib/data';
export function getStaticPaths(){ return USECASES.map(u=>({params:{usecase:u.slug},props:{u}})); }
const { u } = Astro.props;
const ts = u.templates.map(s=>TEMPLATES.find(t=>t.slug===s)!);
const path=`/use-cases/${u.slug}/`;
const ld=[{'@context':'https://schema.org','@type':'WebPage',name:u.name,description:u.goal,url:SITE+path,mainEntity:{'@type':'ItemList',itemListElement:ts.map((t,i)=>({'@type':'ListItem',position:i+1,url:`${SITE}/agent-templates/${t.slug}/`,name:t.name}))}},
{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:SITE+'/'},{'@type':'ListItem',position:2,name:'Use cases',item:SITE+'/use-cases/'},{'@type':'ListItem',position:3,name:u.name,item:SITE+path}]}];
---
<Base title={`${u.name} with an AI agent | Swarmnest`} description={`${u.goal} Ready-made agent templates and tools for this job.`} path={path} jsonld={ld}>
<p class="small"><a href="/use-cases/">Use cases</a> › {u.name}</p>
<h1>{u.name}</h1>
<p class="lead">{u.goal}</p>
<p><strong>What you get:</strong> {u.outcome}</p>
<h2>Agent templates for this use case</h2>
<div class="grid">{ts.map(t=><a class="card" href={`/agent-templates/${t.slug}/`}><h3>{t.name}</h3><p>{t.role}</p></a>)}</div>
<h2>Tools these templates use</h2>
<ul>{[...new Set(ts.flatMap(t=>t.tools))].map(s=>ALL.find(e=>e.slug===s)).filter(Boolean).map(t=><li><a href={`/directory/${t.category}/${t.slug}/`}>{t.name}</a>: {t.description}</li>)}</ul>
</Base>
