---
import Crumbs from '../../../../components/Crumbs.astro';
import Base from '../../../../layouts/Base.astro';
import SkillCard from '../../../../components/SkillCard.astro';
import SkillSearch from '../../../../components/SkillSearch.astro';
import { SKILLS, FORMATS, SITE, skillPath } from '../../../../lib/skills';
export function getStaticPaths(){ return FORMATS.map(f=>({params:{format:f.slug},props:{f}})); }
const { f } = Astro.props; const list = SKILLS.filter(s=>s.format===f.key);
const ld=[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:SITE+'/'},{'@type':'ListItem',position:2,name:'Agent Skills',item:SITE+'/agent-skills/'},{'@type':'ListItem',position:3,name:f.name,item:`${SITE}/agent-skills/format/${f.slug}/`}]},{'@context':'https://schema.org','@type':'ItemList',name:f.name,itemListElement:list.map((s,i)=>({'@type':'ListItem',position:i+1,url:SITE+skillPath(s),name:s.title}))}];
---
<Base title={`${f.name} — ${list.length} Listings | Swarmnest`} description={`${f.blurb} ${list.length} listings.`.slice(0,155)} path={`/agent-skills/format/${f.slug}/`} jsonld={ld}>
<Crumbs items={[['Home','/'],['Agent Skills','/agent-skills/'],[f.name]]} />
<h1>{f.name}</h1>
<p class="lead">{f.blurb}</p>
<p><strong>Portability:</strong> {f.portable}</p>
{f.key==='legacy-gpt' ? (<div>
<div class="notice">Custom GPTs retire on <strong>Dec 11, 2026</strong> (Feb 11, 2027 for approved Enterprise deferrals) and Gems are moving to skills. Because these are going away, we do not list individual GPTs or Gems as installable items. We publish migration guides instead.</div>
<div class="grid">{[{t:'Migrate a Custom GPT to a Skill',u:'/agent-skills/guides/migrate-a-custom-gpt-to-a-skill/',d:'What moves, what does not, and how to rebuild yours.'}].map(g=><a class="card" href={g.u}><h3>{g.t}</h3><p>{g.d}</p></a>)}</div></div>) : (<div>
<SkillSearch fmt={f.slug} label={`Search ${f.name}`} />
<div class="grid" id="ss-list">{list.map(s=><SkillCard s={s} />)}</div></div>)}
<script is:inline src="/search.js"></script>
<script is:inline src="/agent-skills-search.js"></script>
</Base>
